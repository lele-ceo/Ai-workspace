{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "/Users/emanuele/.local/bin/sinapsi hook post-tool-use",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "/Users/emanuele/.local/bin/sinapsi hook session-start",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "/Users/emanuele/.local/bin/sinapsi hook stop",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "/Users/emanuele/.local/bin/sinapsi hook user-prompt-submit",
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(sinapsi:*)",
      "mcp__sinapsi__*",
      "Read(.sinapsi/**)"
    ]
  }
}